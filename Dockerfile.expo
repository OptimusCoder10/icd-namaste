FROM node:20-alpine AS builder

RUN npm install -g pnpm@9

WORKDIR /app

# Copy manifests for layer caching
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY tsconfig.base.json tsconfig.json ./

COPY lib/api-client-react/package.json ./lib/api-client-react/
COPY lib/api-zod/package.json ./lib/api-zod/
COPY lib/api-spec/package.json ./lib/api-spec/
COPY lib/db/package.json ./lib/db/
COPY artifacts/namaste-icd/package.json ./artifacts/namaste-icd/
COPY scripts/package.json ./scripts/

RUN pnpm install --frozen-lockfile || pnpm install --no-frozen-lockfile

COPY lib/ ./lib/
COPY artifacts/namaste-icd/ ./artifacts/namaste-icd/

# EXPO_PUBLIC_API_URL is baked into the JS bundle at build time.
# Override with --build-arg EXPO_PUBLIC_API_URL=http://your-server:8080
ARG EXPO_PUBLIC_API_URL=http://localhost:8080
ENV EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL}
# Keep EXPO_PUBLIC_DOMAIN for backward compat (ApiContext uses this)
ARG EXPO_PUBLIC_DOMAIN=localhost:8080
ENV EXPO_PUBLIC_DOMAIN=${EXPO_PUBLIC_DOMAIN}

WORKDIR /app/artifacts/namaste-icd
RUN pnpm exec expo export --platform web --output-dir dist

# ── Serve with nginx ──────────────────────────────────────────────
FROM nginx:alpine

COPY --from=builder /app/artifacts/namaste-icd/dist /usr/share/nginx/html

# SPA fallback: unknown paths → index.html
RUN printf 'server {\n  listen 3000;\n  root /usr/share/nginx/html;\n  index index.html;\n  location / {\n    try_files $uri $uri/ /index.html;\n  }\n}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
